    },
    {
      "name": "a saved agent position below the limit is restored at 30%",
      "setup": {
        "restore": "agent",
        "saved": 0.1
      },
      "steps": [],
      "expect": {
        "first": 240,
        "second": 560,
        "ratio": 30
      }
    },
    {
      "name": "a saved agent position in range is restored as it was",
      "setup": {
        "restore": "agent",
        "saved": 0.5
      },
      "steps": [],
      "expect": {
        "first": 400,
        "second": 400,
        "ratio": 50
      }
    },
    {
      "name": "the agent limit itself is kept",
      "setup": {
