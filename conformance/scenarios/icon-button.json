{
  "component": "icon-button",
  "description": "Tooltip { IconButton }: the button's behaviour with a tooltip around it.",
  "cases": [
    { "name": "a click fires once", "setup": {},
      "steps": ["click"], "expect": { "clicks": 1 } },
    { "name": "a disabled button doesn't fire", "setup": { "enabled": false },
      "steps": ["click"], "expect": { "clicks": 0 } },
    { "name": "Space fires the focused button", "setup": {},
      "steps": ["focus", { "key": "Space" }], "expect": { "clicks": 1 } },
    { "name": "Enter fires the focused button", "setup": {},
      "steps": ["focus", { "key": "Enter" }], "expect": { "clicks": 1 } },
    { "name": "a click focuses the button", "setup": {},
      "steps": ["click"], "expect": { "focused": true } },
    { "name": "Tab moves on", "setup": { "next": true },
      "steps": ["focus", { "key": "Tab" }], "expect": { "nextFocused": true } }
  ]
}
