{
  "component": "text-area",
  "description": "A multi-line TextArea over a TextFieldState, inside a parent that records the keys it lets through.",
  "cases": [
    { "name": "Enter inserts a line break", "setup": {"text": "ab"},
      "steps": ["focus", {"key": "Enter"}], "expect": {"text": "ab\n", "caret": 3, "bubbled": ""} },
    { "name": "Shift+Enter inserts one too", "setup": {"text": "ab"},
      "steps": ["focus", {"key": "Enter", "mods": ["shift"]}], "expect": {"text": "ab\n"} },
    { "name": "primary+Enter goes to the parent", "setup": {"text": "ab"},
      "steps": ["focus", {"key": "Enter", "mods": ["primary"]}], "expect": {"text": "ab", "bubbled": "primary+Enter"} },
    { "name": "typed and pasted line breaks are kept", "setup": {"text": "", "clipboard": "c\r\nd"},
      "steps": ["focus", {"type": "a\nb"}, {"key": "V", "mods": ["primary"]}], "expect": {"text": "a\nbc\r\nd"} },
    { "name": "Up keeps the column on a line of the same characters", "setup": {"text": "abc\nabc"},
      "steps": ["focus", {"key": "Up"}, {"type": "X"}], "expect": {"text": "abcX\nabc", "caret": 4} },
    { "name": "Up onto a shorter line goes to its end", "setup": {"text": "ab\nlonger"},
      "steps": ["focus", {"key": "Up"}, {"type": "X"}], "expect": {"text": "abX\nlonger"} },
    { "name": "Up past a short line comes back to the column", "setup": {"text": "abcd\nx\nabcd"},
      "steps": ["focus", {"key": "Up"}, {"key": "Up"}, {"type": "Q"}], "expect": {"text": "abcdQ\nx\nabcd"} },
    { "name": "Down past a short line comes back to the column", "setup": {"text": "abcd\nx\nabcd"},
      "steps": ["focus", {"key": "Home", "mods": ["primary"]}, {"key": "End"}, {"key": "Down"}, {"key": "Down"}, {"type": "Q"}], "expect": {"text": "abcd\nx\nabcdQ"} },
    { "name": "Down keeps the column on a line of the same characters", "setup": {"text": "abc\nabc"},
      "steps": ["focus", {"key": "Home", "mods": ["primary"]}, {"key": "Right"}, {"key": "Down"}, {"type": "X"}], "expect": {"text": "abc\naXbc"} },
    { "name": "Up on the first line goes to the start, then to the parent", "setup": {"text": "one\ntwo"},
      "steps": ["focus", {"key": "Up"}, {"key": "Up"}, {"key": "Up"}], "expect": {"caret": 0, "bubbled": "Up"} },
    { "name": "Down on the last line goes to the end, then to the parent", "setup": {"text": "ab\ncd"},
      "steps": ["focus", {"key": "Left"}, {"key": "Down"}, {"key": "Down"}], "expect": {"caret": 5, "bubbled": "Down"} },
    { "name": "Home goes to the start of the line", "setup": {"text": "one\ntwo"},
      "steps": ["focus", {"key": "Home"}, {"type": "X"}], "expect": {"text": "one\nXtwo"} },
    { "name": "End goes to the end of the line", "setup": {"text": "one\ntwo"},
      "steps": ["focus", {"key": "Up"}, {"key": "Home"}, {"key": "End"}, {"type": "X"}], "expect": {"text": "oneX\ntwo"} },
    { "name": "Home at the start of a line stays there", "setup": {"text": "ab\ncd"},
      "steps": ["focus", {"key": "Home"}, {"key": "Home"}], "expect": {"caret": 3, "bubbled": ""} },
    { "name": "primary+Home goes to the start of the text", "setup": {"text": "one\ntwo"},
      "steps": ["focus", {"key": "Home", "mods": ["primary"]}, {"type": "X"}], "expect": {"text": "Xone\ntwo"} },
    { "name": "Shift+Up selects to the same column above", "setup": {"text": "one\ntwo"},
      "steps": ["focus", {"key": "Up", "mods": ["shift"]}], "expect": {"selected": "\ntwo", "caret": 3} },
    { "name": "Shift+Down selects to the same column below", "setup": {"text": "ab\ncd"},
      "steps": ["focus", {"key": "Home", "mods": ["primary"]}, {"key": "Down", "mods": ["shift"]}], "expect": {"selected": "ab\n", "caret": 3} },
    { "name": "select all takes every line", "setup": {"text": "one\ntwo"},
      "steps": ["focus", {"key": "A", "mods": ["primary"]}], "expect": {"selected": "one\ntwo"} },
    { "name": "Backspace at the start of a line joins it to the one above", "setup": {"text": "one\ntwo"},
      "steps": ["focus", {"key": "Home"}, {"key": "Backspace"}], "expect": {"text": "onetwo", "caret": 3} },
    { "name": "Escape and Space go to the parent", "setup": {"text": "ab\ncd"},
      "steps": ["focus", {"key": "A", "mods": ["primary"]}, {"key": "Escape"}, {"key": "Space"}], "expect": {"selected": "ab\ncd", "bubbled": "Escape Space"} },
    { "name": "a line break is an undo step of its own", "setup": {"text": "ab"},
      "steps": ["focus", {"type": "x"}, {"key": "Enter"}, {"key": "Z", "mods": ["primary"]}], "expect": {"text": "abx", "caret": 3} },
    { "name": "each line break is its own undo step", "setup": {"text": "ab"},
      "steps": ["focus", {"key": "Enter"}, {"key": "Enter"}, {"key": "Z", "mods": ["primary"]}], "expect": {"text": "ab\n"} },
    { "name": "typing after a line break is a new undo step", "setup": {"text": "ab"},
      "steps": ["focus", {"type": "x"}, {"key": "Enter"}, {"type": "y"}, {"key": "Z", "mods": ["primary"]}], "expect": {"text": "abx\n"} },
    { "name": "typing a line break with more text merges into the typing before", "setup": {"text": ""},
      "steps": ["focus", {"type": "a"}, {"type": "\nb"}, {"key": "Z", "mods": ["primary"]}], "expect": {"text": ""} },
    { "name": "a read-only area moves the caret and passes edits on", "setup": {"text": "ab\ncd", "readOnly": true},
      "steps": ["focus", {"type": "x"}, {"key": "Up"}, {"key": "Up"}, {"key": "Backspace"}, {"key": "Enter"}], "expect": {"text": "ab\ncd", "caret": 0, "bubbled": "Backspace Enter", "focused": true} },
    { "name": "the placeholder shows while the area is empty", "setup": {"text": "", "placeholder": "Value"},
      "steps": [], "expect": {"placeholder": true} }
  ]
}
