      "name": "zoom starts at 100% with no status bar control",
      "setup": {},
      "steps": [],
      "expect": {
        "zoom": 100,
        "level": 100,
        "controlShown": false
      }
    },
    {
      "name": "zoom in steps to the next level",
      "setup": {},
      "steps": [
