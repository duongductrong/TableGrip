{
  "component": "lazy-tree",
  "description": "The explorer's LazyTree over a fixed tree a(a1, a2(a2x)), b(b1, b2), c. Rows: arrows open, close and move the selection; Shift extends it additively; Shift+click adds the range from the active row, primary+click toggles one row, both make the clicked row active (it stays active when unselected); Up and Down at the ends change nothing; double-click opens and activates; lazy nodes load their children when first opened. Tab takes three presses to leave the tree, Shift+Tab one.",
  "cases": [
    {
      "name": "starts collapsed with nothing selected",
      "setup": {},
      "steps": [],
      "expect": {
        "open": "",
        "selected": "",
        "rows": "a,b,c"
      }
    },
    {
      "name": "a click selects the row",
      "setup": {},
      "steps": [
        {
          "click": "row:a"
        }
      ],
      "expect": {
        "open": "",
        "selected": "a",
        "rows": "a,b,c"
      }
    },
    {
      "name": "a click on another row replaces the selection",
      "setup": {},
      "steps": [
        {
          "click": "row:a"
        },
        {
          "click": "row:b"
        }
      ],
      "expect": {
        "open": "",
        "selected": "b",
        "rows": "a,b,c"
      }
    },
    {
      "name": "Right opens a closed node",
