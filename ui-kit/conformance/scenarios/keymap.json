{
  "component": "keymap",
  "description": "The window's shortcuts over the app's Shortcuts: modifiers must match exactly, 'primary' is Cmd on macOS and Ctrl elsewhere, the preset changes bindings, window shortcuts stand aside while a key is recorded. Preview-phase shortcuts run before the focused control; the others only if it declines. Only keys the runner can press: letters, Enter, Tab, arrows, F2.",
  "cases": [
    {
      "name": "a letter alone is no shortcut",
      "setup": {},
      "steps": [
        "focus",
        {
          "key": "T"
        }
      ],
      "expect": {
        "fired": ""
      }
    },
    {
      "name": "the primary modifier with a letter runs its action",
      "setup": {},
      "steps": [
        "focus",
        {
          "key": "T",
          "mods": [
            "primary"
          ]
        }
      ],
      "expect": {
        "fired": "NewConsole"
      }
    },
    {
      "name": "an extra Shift makes it another shortcut",
      "setup": {},
      "steps": [
        "focus",
        {
          "key": "T",
          "mods": [
            "primary",
            "shift"
          ]
        }
      ],
      "expect": {
        "fired": ""
      }
    },
    {
