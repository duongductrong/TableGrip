    {
      "name": "a preview-phase shortcut runs even when the focused control would take the key",
      "setup": {
        "preview": [
          "NewConsole"
        ],
        "inner": [
          "T"
        ]
      },
      "steps": [
        "focus",
        {
          "key": "T",
          "mods": [
            "primary"
          ]
        }
      ],
      "expect": {
        "fired": "NewConsole",
        "innerHits": 0
      }
    },
    {
      "name": "a bubble-phase shortcut yields to a control that takes the key",
      "setup": {
        "inner": [
          "T"
        ]
      },
      "steps": [
        "focus",
        {
          "key": "T",
          "mods": [
            "primary"
          ]
        }
      ],
      "expect": {
        "fired": "",
        "innerHits": 1
      }
    },
