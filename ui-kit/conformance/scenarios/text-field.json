{
  "component": "text-field",
  "description": "A single-line TextField over a TextFieldState, inside a parent that records the keys it lets through. Typed text arrives with `type`; a key press never types.",
  "cases": [
    { "name": "typing into an empty field", "setup": {"text": ""},
      "steps": ["focus", {"type": "users"}], "expect": {"text": "users", "focused": true} },
    { "name": "focusing puts the caret at the end", "setup": {"text": "user"},
      "steps": ["focus", {"type": "s"}], "expect": {"text": "users"} },
    { "name": "Backspace deletes before the caret", "setup": {"text": "users"},
      "steps": ["focus", {"key": "Backspace"}], "expect": {"text": "user"} },
    { "name": "select all then type replaces the text", "setup": {"text": "users"},
      "steps": ["focus", {"key": "A", "mods": ["primary"]}, {"type": "orders"}], "expect": {"text": "orders"} },
    { "name": "Home then type inserts at the start", "setup": {"text": "users"},
      "steps": ["focus", {"key": "Home"}, {"type": "x"}], "expect": {"text": "xusers"} },
    { "name": "a disabled field takes no input", "setup": {"text": "users", "enabled": false},
      "steps": ["click", {"type": "x"}], "expect": {"text": "users", "focused": false} },
    { "name": "Left moves the caret back one character", "setup": {"text": "users"},
      "steps": ["focus", {"key": "Left"}, {"key": "Left"}, {"type": "X"}], "expect": {"text": "useXrs", "caret": 4} },
    { "name": "End after Home goes back to the end", "setup": {"text": "users"},
      "steps": ["focus", {"key": "Home"}, {"key": "End"}], "expect": {"caret": 5} },
    { "name": "Shift+Left extends the selection from the caret", "setup": {"text": "users"},
      "steps": ["focus", {"key": "Left", "mods": ["shift"]}, {"key": "Left", "mods": ["shift"]}], "expect": {"selected": "rs", "caret": 3} },
    { "name": "Shift+Right shrinks it again", "setup": {"text": "users"},
      "steps": ["focus", {"key": "Left", "mods": ["shift"]}, {"key": "Left", "mods": ["shift"]}, {"key": "Right", "mods": ["shift"]}], "expect": {"selected": "s", "caret": 4} },
    { "name": "Shift+Home selects to the start", "setup": {"text": "users"},
      "steps": ["focus", {"key": "Home", "mods": ["shift"]}], "expect": {"selected": "users", "caret": 0} },
    { "name": "Shift+End after Shift+Home keeps the anchor", "setup": {"text": "users"},
      "steps": ["focus", {"key": "Left"}, {"key": "Home", "mods": ["shift"]}, {"key": "End", "mods": ["shift"]}], "expect": {"selected": "s", "caret": 5} },
    { "name": "Left collapses a selection to its start", "setup": {"text": "users"},
      "steps": ["focus", {"key": "A", "mods": ["primary"]}, {"key": "Left"}], "expect": {"selected": "", "caret": 0} },
    { "name": "Right collapses a selection to its end", "setup": {"text": "users"},
      "steps": ["focus", {"key": "Left"}, {"key": "Left", "mods": ["shift"]}, {"key": "Left", "mods": ["shift"]}, {"key": "Right"}], "expect": {"selected": "", "caret": 4} },
    { "name": "select all twice keeps everything selected", "setup": {"text": "ab"},
      "steps": ["focus", {"key": "A", "mods": ["primary"]}, {"key": "A", "mods": ["primary"]}], "expect": {"selected": "ab"} },
    { "name": "Up goes to the start of a single-line field", "setup": {"text": "users"},
      "steps": ["focus", {"key": "Left"}, {"key": "Up"}], "expect": {"caret": 0, "bubbled": ""} },
    { "name": "Down goes to its end", "setup": {"text": "users"},
      "steps": ["focus", {"key": "Home"}, {"key": "Down"}], "expect": {"caret": 5, "bubbled": ""} },
    { "name": "Delete removes the character after the caret", "setup": {"text": "users"},
      "steps": ["focus", {"key": "Home"}, {"key": "Delete"}], "expect": {"text": "sers", "caret": 0} },
    { "name": "Delete at the end does nothing", "setup": {"text": "users"},
      "steps": ["focus", {"key": "Delete"}], "expect": {"text": "users", "bubbled": ""} },
    { "name": "Backspace at the start does nothing", "setup": {"text": "users"},
      "steps": ["focus", {"key": "Home"}, {"key": "Backspace"}], "expect": {"text": "users", "bubbled": ""} },
    { "name": "Backspace removes the selection", "setup": {"text": "users"},
      "steps": ["focus", {"key": "Left", "mods": ["shift"]}, {"key": "Left", "mods": ["shift"]}, {"key": "Backspace"}], "expect": {"text": "use", "caret": 3} },
    { "name": "typing replaces the selection", "setup": {"text": "users"},
      "steps": ["focus", {"key": "Left", "mods": ["shift"]}, {"key": "Left", "mods": ["shift"]}, {"type": "Z"}], "expect": {"text": "useZ", "caret": 4} },
    { "name": "typed line breaks and tabs are kept", "setup": {"text": ""},
      "steps": ["focus", {"type": "a\nb\tc"}], "expect": {"text": "a\nb\tc"} },
    { "name": "Left steps over a letter with a combining accent", "setup": {"text": "café"},
      "steps": ["focus", {"key": "Left"}, {"type": "X"}], "expect": {"text": "cafXé", "caret": 4} },
    { "name": "Shift+Left selects a letter with its accent", "setup": {"text": "xé"},
      "steps": ["focus", {"key": "Left", "mods": ["shift"]}], "expect": {"selected": "é", "caret": 1} },
    { "name": "Backspace removes a combining accent alone", "setup": {"text": "café"},
      "steps": ["focus", {"key": "Backspace"}], "expect": {"text": "cafe", "caret": 4} },
    { "name": "Backspace removes the last of stacked Vietnamese marks", "setup": {"text": "Việt"},
      "steps": ["focus", {"key": "Left"}, {"key": "Backspace"}], "expect": {"text": "Viẹt", "caret": 3} },
    { "name": "Backspace removes a whole emoji with its skin tone", "setup": {"text": "a👍🏽b"},
      "steps": ["focus", {"key": "Left"}, {"key": "Backspace"}], "expect": {"text": "ab", "caret": 1} },
    { "name": "Backspace removes a whole flag", "setup": {"text": "a🇻🇳"},
      "steps": ["focus", {"key": "Backspace"}], "expect": {"text": "a"} },
    { "name": "Backspace removes a whole family emoji", "setup": {"text": "a👨‍👩‍👧"},
      "steps": ["focus", {"key": "Backspace"}], "expect": {"text": "a"} },
    { "name": "Delete removes a letter with its accent", "setup": {"text": "éx"},
      "steps": ["focus", {"key": "Home"}, {"key": "Delete"}], "expect": {"text": "x"} },
    { "name": "a precomposed Vietnamese letter is one character", "setup": {"text": "Việt"},
      "steps": ["focus", {"key": "Left"}, {"key": "Left", "mods": ["shift"]}], "expect": {"selected": "ệ", "caret": 2} },
    { "name": "copy puts the selection on the clipboard", "setup": {"text": "users", "clipboard": "old"},
      "steps": ["focus", {"key": "A", "mods": ["primary"]}, {"key": "C", "mods": ["primary"]}], "expect": {"clipboard": "users", "text": "users"} },
    { "name": "copy without a selection leaves the clipboard alone", "setup": {"text": "users", "clipboard": "old"},
      "steps": ["focus", {"key": "C", "mods": ["primary"]}], "expect": {"clipboard": "old", "bubbled": ""} },
    { "name": "cut moves the selection to the clipboard", "setup": {"text": "users", "clipboard": "old"},
      "steps": ["focus", {"key": "Left", "mods": ["shift"]}, {"key": "Left", "mods": ["shift"]}, {"key": "X", "mods": ["primary"]}], "expect": {"clipboard": "rs", "text": "use", "caret": 3} },
    { "name": "cut without a selection does nothing", "setup": {"text": "ab", "clipboard": "z"},
      "steps": ["focus", {"key": "X", "mods": ["primary"]}], "expect": {"clipboard": "z", "text": "ab", "bubbled": ""} },
    { "name": "paste inserts at the caret", "setup": {"text": "users", "clipboard": "abc"},
      "steps": ["focus", {"key": "V", "mods": ["primary"]}], "expect": {"text": "usersabc", "caret": 8} },
    { "name": "paste replaces the selection", "setup": {"text": "users", "clipboard": "QQ"},
      "steps": ["focus", {"key": "Home", "mods": ["shift"]}, {"key": "V", "mods": ["primary"]}], "expect": {"text": "QQ", "caret": 2} },
    { "name": "paste keeps line breaks in a single-line field", "setup": {"text": "", "clipboard": "a\r\nb"},
      "steps": ["focus", {"key": "V", "mods": ["primary"]}], "expect": {"text": "a\r\nb"} },
    { "name": "paste with an empty clipboard does nothing", "setup": {"text": "ab"},
      "steps": ["focus", {"key": "V", "mods": ["primary"]}], "expect": {"text": "ab", "bubbled": ""} },
    { "name": "undo removes one typing run", "setup": {"text": ""},
      "steps": ["focus", {"type": "ab"}, {"type": " "}, {"type": "cd"}, {"key": "Z", "mods": ["primary"]}], "expect": {"text": "", "caret": 0} },
    { "name": "typing that continues where the caret came back to still merges", "setup": {"text": ""},
      "steps": ["focus", {"type": "a"}, {"type": "b"}, {"key": "Left"}, {"key": "Right"}, {"type": "c"}, {"key": "Z", "mods": ["primary"]}], "expect": {"text": ""} },
    { "name": "typing elsewhere is a new undo step", "setup": {"text": ""},
      "steps": ["focus", {"type": "ab"}, {"key": "Left"}, {"type": "cd"}, {"key": "Z", "mods": ["primary"]}], "expect": {"text": "ab", "caret": 1} },
    { "name": "Backspaces merge into one undo step", "setup": {"text": "users"},
      "steps": ["focus", {"key": "Backspace"}, {"key": "Backspace"}, {"key": "Z", "mods": ["primary"]}], "expect": {"text": "users", "caret": 5} },
    { "name": "Deletes merge into one undo step", "setup": {"text": "users"},
      "steps": ["focus", {"key": "Home"}, {"key": "Delete"}, {"key": "Delete"}, {"key": "Z", "mods": ["primary"]}], "expect": {"text": "users", "caret": 0} },
    { "name": "switching from Backspace to Delete starts a new step", "setup": {"text": "users"},
      "steps": ["focus", {"key": "Left"}, {"key": "Backspace"}, {"key": "Delete"}, {"key": "Z", "mods": ["primary"]}], "expect": {"text": "uses", "caret": 3} },
    { "name": "Backspace after typing is a step of its own", "setup": {"text": ""},
      "steps": ["focus", {"type": "ab"}, {"key": "Backspace"}, {"key": "Z", "mods": ["primary"]}], "expect": {"text": "ab", "caret": 2} },
    { "name": "typing after Backspace is a step of its own", "setup": {"text": "xy"},
      "steps": ["focus", {"key": "Backspace"}, {"type": "ab"}, {"key": "Z", "mods": ["primary"]}], "expect": {"text": "x", "caret": 1} },
    { "name": "undo of typing over a selection restores the selection", "setup": {"text": "users"},
      "steps": ["focus", {"key": "A", "mods": ["primary"]}, {"type": "c"}, {"key": "Z", "mods": ["primary"]}], "expect": {"text": "users", "selected": "users"} },
    { "name": "typing after typing over a selection is a new step", "setup": {"text": "users"},
      "steps": ["focus", {"key": "A", "mods": ["primary"]}, {"type": "c"}, {"type": "d"}, {"key": "Z", "mods": ["primary"]}], "expect": {"text": "c", "caret": 1} },
    { "name": "undo of a deleted selection restores it", "setup": {"text": "users"},
      "steps": ["focus", {"key": "Left", "mods": ["shift"]}, {"key": "Left", "mods": ["shift"]}, {"key": "Backspace"}, {"key": "Z", "mods": ["primary"]}], "expect": {"text": "users", "selected": "rs", "caret": 3} },
    { "name": "undo of a cut restores the selection", "setup": {"text": "users"},
      "steps": ["focus", {"key": "A", "mods": ["primary"]}, {"key": "X", "mods": ["primary"]}, {"key": "Z", "mods": ["primary"]}], "expect": {"text": "users", "selected": "users"} },
    { "name": "a paste is a step of its own", "setup": {"text": "", "clipboard": "P"},
      "steps": ["focus", {"type": "a"}, {"key": "V", "mods": ["primary"]}, {"type": "b"}, {"key": "Z", "mods": ["primary"]}, {"key": "Z", "mods": ["primary"]}], "expect": {"text": "a", "caret": 1} },
    { "name": "two pastes are two steps", "setup": {"text": "", "clipboard": "ab"},
      "steps": ["focus", {"key": "V", "mods": ["primary"]}, {"key": "V", "mods": ["primary"]}, {"key": "Z", "mods": ["primary"]}], "expect": {"text": "ab", "caret": 2} },
    { "name": "undo with nothing to undo does nothing", "setup": {"text": "users"},
      "steps": ["focus", {"key": "Z", "mods": ["primary"]}], "expect": {"text": "users", "bubbled": ""} },
    { "name": "Shift+primary+Z redoes", "setup": {"text": ""},
      "steps": ["focus", {"type": "a"}, {"key": "Left"}, {"type": "b"}, {"key": "Z", "mods": ["primary"]}, {"key": "Z", "mods": ["primary"]}, {"key": "Z", "mods": ["primary", "shift"]}, {"key": "Z", "mods": ["primary", "shift"]}], "expect": {"text": "ba", "caret": 1} },
    { "name": "primary+Y redoes too", "setup": {"text": "x"},
      "steps": ["focus", {"type": "a"}, {"key": "Z", "mods": ["primary"]}, {"key": "Y", "mods": ["primary"]}], "expect": {"text": "xa", "caret": 2} },
    { "name": "an edit after undo drops the redo", "setup": {"text": ""},
      "steps": ["focus", {"type": "a"}, {"key": "Left"}, {"type": "b"}, {"key": "Z", "mods": ["primary"]}, {"type": "c"}, {"key": "Z", "mods": ["primary", "shift"]}], "expect": {"text": "ca", "caret": 1} },
    { "name": "Enter and Escape go to the parent", "setup": {"text": "users"},
      "steps": ["focus", {"key": "Enter"}, {"key": "Escape"}], "expect": {"text": "users", "bubbled": "Enter Escape"} },
    { "name": "modified Enter and Escape go to the parent", "setup": {"text": "users"},
      "steps": ["focus", {"key": "Enter", "mods": ["shift"]}, {"key": "Escape", "mods": ["shift"]}, {"key": "Enter", "mods": ["primary"]}], "expect": {"bubbled": "shift+Enter shift+Escape primary+Enter"} },
    { "name": "Escape keeps the selection", "setup": {"text": "ab"},
      "steps": ["focus", {"key": "A", "mods": ["primary"]}, {"key": "Escape"}], "expect": {"selected": "ab", "bubbled": "Escape"} },
    { "name": "Left at the start goes to the parent", "setup": {"text": "users"},
      "steps": ["focus", {"key": "Home"}, {"key": "Left"}], "expect": {"caret": 0, "bubbled": "Left"} },
    { "name": "Right at the end goes to the parent", "setup": {"text": "users"},
      "steps": ["focus", {"key": "Right"}], "expect": {"caret": 5, "bubbled": "Right"} },
    { "name": "Up at the start and Down at the end go to the parent", "setup": {"text": "ab"},
      "steps": ["focus", {"key": "Down"}, {"key": "Home"}, {"key": "Up"}], "expect": {"bubbled": "Down Up"} },
    { "name": "arrows in an empty field go to the parent", "setup": {"text": ""},
      "steps": ["focus", {"key": "Left"}, {"key": "Right"}, {"key": "Up"}, {"key": "Down"}, {"key": "Backspace"}, {"key": "Delete"}], "expect": {"bubbled": "Left Right Up Down"} },
    { "name": "Home and End at the ends stay in the field", "setup": {"text": "ab"},
      "steps": ["focus", {"key": "End"}, {"key": "Home"}, {"key": "Home"}], "expect": {"caret": 0, "bubbled": ""} },
    { "name": "a shifted arrow at the start stays in the field", "setup": {"text": "ab"},
      "steps": ["focus", {"key": "Home"}, {"key": "Left", "mods": ["shift"]}, {"key": "Up", "mods": ["shift"]}], "expect": {"caret": 0, "bubbled": ""} },
    { "name": "Left with a selection at the start stays in the field", "setup": {"text": "ab"},
      "steps": ["focus", {"key": "Home", "mods": ["shift"]}, {"key": "Left"}], "expect": {"caret": 0, "bubbled": ""} },
    { "name": "the Space key goes to the parent: typed text comes separately", "setup": {"text": "ab"},
      "steps": ["focus", {"key": "Space"}, {"key": "Space", "mods": ["primary"]}], "expect": {"text": "ab", "bubbled": "Space primary+Space"} },
    { "name": "Tab moves focus on", "setup": {"text": "users", "next": true},
      "steps": ["focus", {"key": "A", "mods": ["primary"]}, {"key": "Tab"}], "expect": {"nextFocused": true, "text": "users"} },
    { "name": "a read-only field takes focus but no typing", "setup": {"text": "users", "readOnly": true},
      "steps": ["focus", {"type": "x"}], "expect": {"text": "users", "focused": true} },
    { "name": "a read-only field lets the caret move", "setup": {"text": "users", "readOnly": true},
      "steps": ["focus", {"key": "Left"}, {"key": "Home"}], "expect": {"caret": 0, "bubbled": ""} },
    { "name": "a read-only field copies", "setup": {"text": "users", "readOnly": true, "clipboard": "z"},
      "steps": ["focus", {"key": "A", "mods": ["primary"]}, {"key": "C", "mods": ["primary"]}], "expect": {"clipboard": "users", "bubbled": ""} },
    { "name": "a read-only field passes editing keys to the parent", "setup": {"text": "users", "readOnly": true, "clipboard": "z"},
      "steps": ["focus", {"key": "A", "mods": ["primary"]}, {"key": "Backspace"}, {"key": "Delete"}, {"key": "X", "mods": ["primary"]}, {"key": "V", "mods": ["primary"]}, {"key": "Z", "mods": ["primary"]}, {"key": "Enter"}], "expect": {"text": "users", "clipboard": "z", "bubbled": "Backspace Delete primary+X primary+V primary+Z Enter"} },
    { "name": "a disabled field gets no keys", "setup": {"text": "users", "enabled": false},
      "steps": ["click", {"key": "Enter"}], "expect": {"focused": false, "bubbled": ""} },
    { "name": "a password field keeps what is typed", "setup": {"text": "", "password": true},
      "steps": ["focus", {"type": "pässwörd"}], "expect": {"text": "pässwörd", "caret": 8} },
    { "name": "a password field copies bullets", "setup": {"text": "secret", "password": true, "clipboard": "z"},
      "steps": ["focus", {"key": "A", "mods": ["primary"]}, {"key": "C", "mods": ["primary"]}], "expect": {"clipboard": "••••••", "text": "secret"} },
    { "name": "a password field cuts bullets", "setup": {"text": "secret", "password": true, "clipboard": "z"},
      "steps": ["focus", {"key": "A", "mods": ["primary"]}, {"key": "X", "mods": ["primary"]}], "expect": {"clipboard": "••••••", "text": ""} },
    { "name": "a password field undoes", "setup": {"text": "", "password": true},
      "steps": ["focus", {"type": "ab"}, {"key": "Z", "mods": ["primary"]}], "expect": {"text": ""} },
    { "name": "the placeholder shows while the field is empty", "setup": {"text": "", "placeholder": "Search"},
      "steps": [], "expect": {"placeholder": true} },
    { "name": "the placeholder stays when the field takes focus", "setup": {"text": "", "placeholder": "Search"},
      "steps": ["focus"], "expect": {"placeholder": true} },
    { "name": "the placeholder hides when there is text", "setup": {"text": "a", "placeholder": "Search"},
      "steps": [], "expect": {"placeholder": false} },
    { "name": "the placeholder hides on typing", "setup": {"text": "", "placeholder": "Search"},
      "steps": ["focus", {"type": "a"}], "expect": {"placeholder": false} },
    { "name": "the placeholder comes back when the field is emptied", "setup": {"text": "", "placeholder": "Search"},
      "steps": ["focus", {"type": "a"}, {"key": "Backspace"}], "expect": {"placeholder": true} },
    { "name": "a click focuses and puts the caret where it lands", "setup": {"text": "users"},
      "steps": ["click", {"type": "X"}], "expect": {"text": "usersX", "focused": true} },
    { "name": "a click clears the selection", "setup": {"text": "users"},
      "steps": ["focus", {"key": "A", "mods": ["primary"]}, "click"], "expect": {"selected": "", "caret": 5} },
    { "name": "a double-click selects the word under the pointer", "setup": {"text": "hello world"},
      "steps": ["focus", {"key": "Home"}, "doubleClick"], "expect": {"selected": "world", "caret": 11} }
  ]
}
