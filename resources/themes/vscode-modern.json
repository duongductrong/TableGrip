        "#C586C0"
      ]
    },
    {
      "name": "VS Code Light Modern",
      "appearance": "light",
      "colors": {
        "frame.background": "#F8F8F8",
        "island.background": "#FFFFFF",
        "island.border": "#00000017",
        "divider": "#E5E5E5",
        "accent": "#005FB8",
        "accent.foreground": "#FFFFFF",
        "text": "#3B3B3B",
