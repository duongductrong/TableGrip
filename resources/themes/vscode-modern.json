{
  "$schema": "https://tablegrip.dev/schema/theme-v1.json",
  "name": "VS Code Modern",
  "author": "Microsoft (VS Code's Dark Modern and Light Modern)",
  "license": "MIT",
  "themes": [
    {
      "name": "VS Code Dark Modern",
      "appearance": "dark",
      "colors": {
        "frame.background": "#181818",
        "island.background": "#1F1F1F",
        "island.border": "#FFFFFF0F",
        "divider": "#2B2B2B",
        "accent": "#0078D4",
        "accent.foreground": "#FFFFFF",
        "text": "#CCCCCC",
        "text.muted": "#9D9D9D",
        "text.disabled": "#6E7681",
        "border": "#2B2B2B",
        "border.focused": "#0078D4",
        "text.link": "#4DAAFC",
        "input.background": "#313131",
        "input.border": "#3C3C3C",
        "popup.background": "#1F1F1F",
        "popup.border": "#454545",
        "list.selection.background": "#04395E",
        "list.selection.inactive.background": "#37373D",
        "list.hover.background": "#2A2D2E",
        "button.secondary.border": "#3C3C3C",
        "editor.currentLine": "#FFFFFF0A",
        "editor.findMatch": "#EA5C0055",
        "editor.findMatch.current": "#9E6A03",
        "editor.bracket": "#0064001A",
        "editor.bracket.border": "#888888"
